<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="GradeManagementDB"
         connectionString="Server=.\SQLEXPRESS;Database=GradeManagementDB;Integrated Security=True;Connect Timeout=15;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="LogDirectory" value="Logs" />
    <add key="LogLevel" value="Info" />
    <add key="ApiBaseUrl" value="https://isdayoff.ru" />
    <add key="ApiTimeoutSeconds" value="10" />
    <add key="PageSize" value="50" />
    <add key="DefaultCourse" value="1" />
  </appSettings>
</configuration>
